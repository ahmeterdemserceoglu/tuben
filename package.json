{
  "name": "tuben",
  "version": "1.0.2",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@shopify/flash-list": "2.0.2",
    "expo": "~57.0.22",
    "expo-file-system": "~57.0.7",
    "expo-linear-gradient": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.4",
    "firebase": "^12.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "cross-env": "^10.0.0",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --pretty false",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:windows": "cross-env EXPO_PUBLIC_TUBEN_DESKTOP=1 expo export --platform web --output-dir dist-windows",
    "dev:windows": "cross-env EXPO_PUBLIC_TUBEN_DESKTOP=1 expo start --web --port 19007",
    "build:windows": "npm run export:windows && npm --prefix windows-player run build:windows"
  },
  "private": true
